# AlphaBeta Environment Variables Template
# Copy these into your Vercel Project Settings (Settings -> Environment Variables)

# 1. MongoDB Atlas Connection URI (Free forever)
# Example: mongodb+srv://username:password@cluster0.abcde.mongodb.net/alphabeta?retryWrites=true&w=majority
MONGODB_URI=

# 2. Cloudinary Credentials (25GB Free permanent photo/video hosting)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
